{
  "name": "neo-media-digest",
  "version": "1.0.0",
  "description": "Neo Logistics Media Center digest - CBIC/DGFT notifications, trade news, and blog drafts",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "once": "tsx src/run-once.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
