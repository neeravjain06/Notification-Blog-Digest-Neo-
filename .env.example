# This service's own port. (Plain PORT is deliberately NOT read: in the scaffold it is the main app.)
NOTIFICATIONS_DIGEST_PORT=8791

# LLM - placeholder until the key is supplied. Field names match Neo's own scaffold
# env file: OpenRouter, an OpenAI-compatible REST API.
# stub = deterministic offline summariser. No key, no network, nothing to misconfigure.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Per-service override, matching the scaffold's DIGEST_AI_MODEL / AI_MODEL split.
# Either name works - DIGEST_AI_MODEL wins if both are set.
DIGEST_AI_MODEL=
AI_MODEL=

# Each of the next settings also accepts a DIGEST_ prefix (DIGEST_SCAN_INTERVAL_HOURS ...), matching the scaffold.
SCAN_INTERVAL_HOURS=24
BLOG_INTERVAL_HOURS=168
MAX_PUBLISH_PER_DAY=5
MIN_OK_CHANNELS=2

# Required (DIGEST_ADMIN_TOKEN also works). Gates /api/status, /api/costs and /api/run. No open default.
ADMIN_TOKEN=

# true = run scheduled cycles after boot (spends LLM money). false = manual only.
DIGEST_AUTO_MACHINE=false
DIGEST_BOOT_DELAY_MS=15000

# Optional. Directory for the static feed export, e.g. a mounted volume a site build reads.
PUBLISH_EXPORT_DIR=

ENABLED_PIPELINES=notifications,news,blogs
