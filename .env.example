PORT=8791

# LLM - placeholder until the provider and key are supplied.
# stub = deterministic offline summariser. No key, no network, no vendor decision.
# Any other value requires AI_API_KEY to be set or the service refuses to boot.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=

SCAN_INTERVAL_HOURS=24
BLOG_INTERVAL_HOURS=168
MAX_PUBLISH_PER_DAY=5
MIN_OK_CHANNELS=2

# Required. Gates /api/status, /api/costs and the admin page. There is no open default.
ADMIN_TOKEN=

# Optional. Directory for the static feed export, e.g. a mounted volume a site build reads.
PUBLISH_EXPORT_DIR=

ENABLED_PIPELINES=notifications,news,blogs
